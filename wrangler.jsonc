{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wheretomeet",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wheretomeet-search-events",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "vars": { "ENVIRONMENT": "development" }
}
