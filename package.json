{
  "name": "wheretomeet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "catalog:build": "node scripts/build-hubs.mjs",
    "catalog:preview": "node scripts/build-hubs.mjs --preview",
    "db:migrate": "wrangler d1 migrations apply wheretomeet-search-events --local",
    "worker:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}

