# 공개 브라우저 키: 승인된 Kakao 웹 도메인으로 사용 범위를 제한한다.
VITE_KAKAO_JS_KEY=

# 서버 전용 비밀 값: Wrangler는 .dev.vars, CLI 검증은 .env에 복사한다.
# 배포 비밀 값은 wrangler secret put으로 설정하고 VITE_ 접두사는 사용하지 않는다.
KAKAO_REST_API_KEY=
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# 실제 공급자의 시간 의미와 교통수단 범위를 검증한 후에만 활성화한다.
ROUTING_APPROVED=false
# 무료 요금제 제공량을 추정하지 말고 계정에서 확인된 할당량을 입력한다.
TRAVELTIME_HITS_PER_MINUTE=
TRAVELTIME_HITS_PER_SEARCH=
MAX_CONCURRENT_SEARCHES=1

# /privacy에 표시할 공개 운영자 정보. 공개 운영 전에 반드시 설정한다.
VITE_OPERATOR_NAME=
VITE_OPERATOR_CONTACT=

# 출시 식별 정보와 증빙. Android 생성 전에 실제 값을 입력한다.
APP_ORIGIN=
ANDROID_PACKAGE_ID=
PLAY_APP_SIGNING_SHA256=
ROUTING_APPROVAL_FILE=
ANDROID_VALIDATION_FILE=

# 원격 배포 전에 모두 0인 로컬 D1 자리표시자를 교체한다.
# 운영용 공급자 한도와 인증 정보는 명시적으로 설정해야 한다.
