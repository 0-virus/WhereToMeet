# Public browser key: restrict it to authorized Kakao web domains.
VITE_KAKAO_JS_KEY=

# Server-only secrets: copy these to .dev.vars for Wrangler, or .env for CLI validation.
# Configure deployed secrets with wrangler secret put; never use a VITE_ prefix.
KAKAO_REST_API_KEY=
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# Enable only after real provider semantics/transport-scope verification.
ROUTING_APPROVED=false
# Fill using the account's confirmed quota, not an assumed free-tier allowance.
TRAVELTIME_HITS_PER_MINUTE=
TRAVELTIME_HITS_PER_SEARCH=
MAX_CONCURRENT_SEARCHES=1

# Public operator details for /privacy; required before public operation.
VITE_OPERATOR_NAME=
VITE_OPERATOR_CONTACT=

# Release identity/evidence; supply real values before Android generation.
APP_ORIGIN=
ANDROID_PACKAGE_ID=
PLAY_APP_SIGNING_SHA256=
ROUTING_APPROVAL_FILE=
ANDROID_VALIDATION_FILE=

# Replace the all-zero local D1 placeholder before any remote deployment.
# Production provider limits and credentials must be explicitly configured.
